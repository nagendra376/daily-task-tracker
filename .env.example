# ==========================================
# GitHub Daily Task Tracker Configuration
# ==========================================

# Server Port
PORT=3001

# GitHub Personal Access Token (PAT)
# - Fine-grained PAT: Requires "Contents: Read and write" repository permissions
# - Classic PAT: Requires "repo" scope
# Token is ONLY used on the server and is NEVER sent to the client browser.
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Repository Owner (Username or Organization)
# Example: octocat
GITHUB_OWNER=your_github_username

# GitHub Repository Name
# Example: daily-task-tracker
GITHUB_REPO=daily-task-tracker

# GitHub Branch (default: main)
GITHUB_BRANCH=main

# Path inside the repository where date JSON files are saved (default: tasks)
TASKS_PATH=tasks
